# ---- BABA AI YouTube Agent - Environment Variables ----
# इस फ़ाइल की कॉपी बनाकर नाम .env रखें और अपनी वास्तविक API Key डालें।
# Copy this file to .env and fill in your real API keys.
# कभी भी .env फ़ाइल को public (GitHub आदि) पर न डालें।

# Gemini AI API Key (स्क्रिप्ट और SEO बनाने के लिए जरूरी)
# https://aistudio.google.com/apikey पर जाकर free API Key बनाएँ
GEMINI_API_KEY=your_gemini_api_key_here

# ---- नीचे की कुंजियाँ भविष्य के वीडियो/अपलोड features के लिए हैं (अभी जरूरी नहीं) ----

# YouTube Upload (OAuth 2.0)
# Google Cloud Console -> APIs -> YouTube Data API v3 -> Credentials
# YOUTUBE_CLIENT_ID=your_youtube_client_id
# YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# Text-to-Speech (हिंदी आवाज के लिए)
# Google Cloud TTS: https://cloud.google.com/text-to-speech
# TTS_API_KEY=your_tts_api_key

# Image Generation (वीडियो दृश्यों के लिए)
# IMAGE_API_KEY=your_image_api_key
