# BABA AI — secrets केवल Render Environment / local .env में रखें; GitHub में असली secrets न डालें.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_SCRIPT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Google Cloud Console: YouTube Data API v3 enable करें और OAuth Web Client बनाएँ.
YOUTUBE_CLIENT_ID=your_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret
# इसे Render service के exact public URL के साथ Google OAuth redirect URI में भी जोड़ें:
YOUTUBE_REDIRECT_URI=https://YOUR-RENDER-SERVICE.onrender.com/api/youtube/callback
# Random secret, कम-से-कम 32 अक्षर. OAuth token browser cookie में AES-GCM से encrypted रहेगा.
APP_SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Optional PostgreSQL persistence for automation job metadata/history.
# Do not commit real credentials.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DATABASE_SSL=disable
# AUTOMATION_DB_POOL_MAX=3
